// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  business_id String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  mobile      String   @unique
  email       String   @unique
  address     String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)  
  active      Boolean  @default(true)
  menu_url    String?
  created_at  DateTime @default(now())

  products                 Product[]
  orders                   Order[]
  businessInvitations      BusinessInvitations[]
  BusinessUser             BusinessUser[]

  @@map("business")
}

model BusinessInvitations {
  business_invitation_id  String   @id @default(uuid()) @db.Uuid
  business_id             String   @db.Uuid
  email                   String
  role                    UserRole
  token                   String
  status                  InvitationStatus
  expired_at              DateTime @default(now())  

  business Business @relation(fields: [business_id], references: [business_id])

  @@map("business_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model BusinessUser {
  business_user_id  String   @id @default(uuid()) @db.Uuid
  business_id       String   @db.Uuid
  user_id           String   @db.Uuid
  role              UserRole
  created_at        DateTime @default(now())  

  business Business @relation(fields: [business_id], references: [business_id])

  user User @relation(fields: [user_id], references: [user_id])

  @@index([business_id, user_id])

  @@map("business_user")
}

model User {
  user_id       String   @id @default(uuid()) @db.Uuid
  email         String   @unique  
  phone         String   @unique
  name          String
  password_hash String
  active        Boolean  @default(true)
  created_at  DateTime @default(now())

  BusinessUser   BusinessUser[]
  orders   Order[]

  @@map("users")
}

enum UserRole {
  ADMIN
  OWNER
  STAFF
}

model Product {
  product_id    String   @id @default(uuid()) @db.Uuid
  business_id   String   @db.Uuid
  sub_category_id   String   @db.Uuid
  name          String
  description   String? 
  current_price Decimal  @db.Decimal(10,2)
  active        Boolean  @default(true)
  image         String?

  business Business @relation(fields: [business_id], references: [business_id])
  subCategories SubCategory @relation(fields: [sub_category_id], references: [sub_category_id])

  orderItems OrderItem[]

  @@index([business_id])
  @@map("products")
}

model Category {
  category_id String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120) //Identificador amigable para URLs/filtros
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(255)
  image       String?  @db.VarChar(255)
  order       Int      @default(0)              //Controlar el orden en que aparecen
  active      Boolean  @default(true)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  sub_category_id  String   @id @default(uuid()) @db.Uuid
  category_id     String   @unique @db.Uuid 
  name            String   @unique @db.VarChar(100)
  slug            String   @unique @db.VarChar(120)
  description     String?  @db.VarChar(255)
  order           Int      @default(0)
  active          Boolean  @default(true)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  category Category @relation(fields: [category_id], references: [category_id])

  products   Product[]

  @@map("sub_categories")
}

model Order {
  order_id    String      @id @default(uuid()) @db.Uuid
  business_id String      @db.Uuid
  user_id     String      @db.Uuid
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(10,2)
  created_at  DateTime    @default(now())

  business Business @relation(fields: [business_id], references: [business_id])

  user User @relation(fields: [user_id], references: [user_id])

  items OrderItem[]

  @@index([business_id, created_at])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  CANCELLED
  DELIVERED
}

model OrderItem {
  order_item_id String   @id @default(uuid()) @db.Uuid
  order_id      String   @db.Uuid
  product_id    String  @db.Uuid
  product_name  String
  unit_price    Decimal  @db.Decimal(10,2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(10,2)

  order Order @relation(fields: [order_id], references: [order_id])

  product Product @relation(fields: [product_id], references: [product_id])

  @@index([order_id])
  @@map("order_items")
}
