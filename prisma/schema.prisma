// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  business_id           String   @id @default(uuid()) @db.Uuid
  name                  String   
  mobile                String   
  email                 String   
  address               String?
  latitude              Decimal? @db.Decimal(10, 7)
  longitude             Decimal? @db.Decimal(10, 7)  
  active                Boolean  @default(true) //El negocio existe y está habilitado en la plataforma
  menu_url              String?
  timezone              String   @default("America/Bogota")
  default_prep_time     Int      @default(30)  // minutos de preparación de pedidos
  last_order_offset     Int      @default(30)  // min antes del cierre
  is_accepting_orders   Boolean  @default(true) // El dueño decide recibir o no pedidos ahora
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  //TODO: manejar cierres temporales de negocio
  //temporarily_closed    Boolean  @default(false) // Algo impide operar temporalmente
  //closed_until        DateTime? // si tiene valor y ya pasó, el sistema reactiva
  //closed_reason       String?   // "Sin masa", "Saturado", "Sin luz"

  Products                 Product[]
  Orders                   Order[]
  BusinessInvitations      BusinessInvitations[]
  BusinessUser             BusinessUser[]
  BusinessRatings          BusinessRating[]
  Hours                    BusinessHours[]
  Closures                 BusinessClosure[]  

  @@unique([name, mobile, email])

  @@map("business")
}

model BusinessHours {
  business_hour_id   String  @id @default(uuid()) @db.Uuid
  business_id        String  @db.Uuid
  day_of_week        Int     // 0=domingo ... 6=sábado
  open_time          String  // "08:00"
  close_time         String  // "22:00"
  is_closed          Boolean @default(false) // día cerrado

  business Business @relation(fields: [business_id], references: [business_id], onDelete: Cascade)

  @@unique([business_id, day_of_week, open_time])
  @@index([business_id])
  @@map("business_hours")
}

model BusinessClosure {
  business_closure_id   String   @id @default(uuid()) @db.Uuid
  business_id           String   @db.Uuid
  start_at              DateTime
  end_at                DateTime
  reason                String?

  business Business @relation(fields: [business_id], references: [business_id], onDelete: Cascade)

  @@index([business_id, start_at, end_at])
  @@map("business_closure")
}

model BusinessInvitations {
  business_invitation_id  String   @id @default(uuid()) @db.Uuid
  business_id             String   @db.Uuid
  email                   String
  role                    UserRole
  token                   String
  status                  InvitationStatus
  expired_at              DateTime @default(now())  

  business Business @relation(fields: [business_id], references: [business_id])

  @@map("business_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model BusinessUser {
  business_user_id  String   @id @default(uuid()) @db.Uuid
  business_id       String   @db.Uuid
  user_id           String   @db.Uuid
  role              UserRole
  created_at        DateTime @default(now())  

  Business Business @relation(fields: [business_id], references: [business_id])
  User     User     @relation(fields: [user_id], references: [user_id])

  @@index([business_id, user_id])
  @@map("business_user")
}

model User {
  user_id       String   @id @default(uuid()) @db.Uuid
  email         String     
  phone         String  
  name          String
  password_hash String
  active        Boolean  @default(true)
  created_at  DateTime @default(now())

  BusinessUser    BusinessUser[]
  Orders          Order[]
  BusinessRatings BusinessRating[]
  ProductRatings  ProductRating[]

  @@unique([email, phone])

  @@map("users")
}

enum UserRole {
  ADMIN
  OWNER
  STAFF
}

model Product {
  product_id      String   @id @default(uuid()) @db.Uuid
  business_id     String   @db.Uuid
  sub_category_id String   @db.Uuid
  name            String
  description     String? 
  current_price   Decimal  @db.Decimal(10,2)
  active          Boolean  @default(true)
  image           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  Business      Business    @relation(fields: [business_id], references: [business_id])
  SubCategories SubCategory @relation(fields: [sub_category_id], references: [sub_category_id])

  OrderItems      OrderItem[]
  ProductRatings  ProductRating[]

  @@index([business_id, sub_category_id])
  @@map("products")
}

model Category {
  category_id String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(120)                //Identificador amigable para URLs/filtros
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(255)
  image       String?  @db.VarChar(255)
  order       Int      @default(0)                     //Controlar el orden en que aparecen
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  subCategories SubCategory[]

  @@unique([slug])
  @@map("categories")
}

model SubCategory {
  sub_category_id String   @id @default(uuid()) @db.Uuid
  category_id     String   @db.Uuid 
  name            String   @db.VarChar(100)
  slug            String   @db.VarChar(120)
  description     String?  @db.VarChar(255)
  order           Int      @default(0)
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  category Category @relation(fields: [category_id], references: [category_id])

  products   Product[]

  @@unique([category_id, name, slug])
  @@map("sub_categories")
}


model Order {
  order_id    String      @id @default(uuid()) @db.Uuid
  business_id String      @db.Uuid
  user_id     String      @db.Uuid
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(10,2)
  created_at  DateTime    @default(now())
  cutoff_at   DateTime? // hora en que se dejaban de aceptar pedidos vigente al crear el pedido, calculado con el last_order_offset del negocio
  ready_at    DateTime? // estimación de listo al crear el pedido, se calcula con el tiempo de preparación del negocio
  accepted_at DateTime  // cuándo se aceptó realmente
  ready_real  DateTime? // cuándo estuvo listo realmente, cuando el negocio lo marcó como listo  

  business Business @relation(fields: [business_id], references: [business_id])
  user     User     @relation(fields: [user_id], references: [user_id])

  items           OrderItem[]
  BusinessRatings BusinessRating?
  ProductRatings  ProductRating[]

  @@index([business_id, created_at])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  CANCELLED
  DELIVERED
}

model OrderItem {
  order_item_id String   @id @default(uuid()) @db.Uuid
  order_id      String   @db.Uuid
  product_id    String   @db.Uuid
  product_name  String
  unit_price    Decimal  @db.Decimal(10,2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(10,2)

  order   Order   @relation(fields: [order_id], references: [order_id])
  product Product @relation(fields: [product_id], references: [product_id])

  @@index([order_id])
  @@map("order_items")
}

model BusinessRating {
  business_rating_id  String    @id @default(uuid()) @db.Uuid
  business_id         String    @db.Uuid
  user_id             String    @db.Uuid
  order_id            String    @db.Uuid
  score               Int
  comment             String?  @db.VarChar(1000)
  active              Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([user_id])
  @@unique([order_id])
  @@index([business_id])
  @@index([user_id])
  @@index([order_id])

  business  Business  @relation(fields: [business_id], references: [business_id])
  User      User      @relation(fields: [user_id], references: [user_id])
  Order     Order     @relation(fields: [order_id], references: [order_id])

  @@map("business_ratings")
}

model ProductRating {
  product_rating_id String  @id @default(uuid()) @db.Uuid
  product_id        String  @db.Uuid
  user_id           String  @db.Uuid
  order_id          String  @db.Uuid
  score             Int
  comment           String? @db.VarChar(1000)
  active            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [product_id])
  user    User    @relation(fields: [user_id], references: [user_id])
  order   Order   @relation(fields: [order_id ], references: [order_id ])

  @@unique([user_id, product_id, order_id])
  @@index([product_id])
  @@index([user_id])
  @@index([order_id])

  @@map("product_ratings")
}
